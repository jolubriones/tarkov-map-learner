# ---------------------------------------------------------------------------
# SEO
# Canonical site URL for canonical links, OG tags, and sitemap.xml.
# Set to the production domain before launch, then rebuild.
# NEXT_PUBLIC_SITE_URL=https://tarkov-map-learner.example.com

# ---------------------------------------------------------------------------
# Monetization (display ads + donations)
# Everything is OFF by default. See docs/monetization.md for the full guide.
# NOTE: NEXT_PUBLIC_* values are inlined at build time — redeploy after changes.
# ---------------------------------------------------------------------------

# --- Display ads ------------------------------------------------------------
# Master switch for <AdSlot /> placements.
NEXT_PUBLIC_ADS_ENABLED=false

# Ad provider: "adsense" | "custom" | "none".
# - adsense: loads the AdSense script + renders each slot's ad unit.
# - custom:  renders first-party creative passed as <AdSlot> children.
NEXT_PUBLIC_AD_PROVIDER=none

# AdSense publisher ID (required when provider is "adsense").
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Provider ad-unit IDs per placement (AdSense "data-ad-slot" values).
# NEXT_PUBLIC_AD_SLOT_BELOW_CONTENT=
# NEXT_PUBLIC_AD_SLOT_GAME_OVER=

# Preview mode: show dashed placeholder boxes at every placement without a
# live provider. For local layout review only — never enable in production.
NEXT_PUBLIC_ADS_PLACEHOLDER=false

# --- Donations --------------------------------------------------------------
# Setting a URL lights up every <DonateButton /> placement (drill header,
# game-over screen, footer). Leave empty to keep donations hidden.
# NEXT_PUBLIC_DONATION_URL=https://ko-fi.com/your-page
NEXT_PUBLIC_DONATION_PLATFORM=Ko-fi
NEXT_PUBLIC_DONATION_MESSAGE=Support Tarkov Map Learner
# Perk note under the donate button (donor ad-free promise).
NEXT_PUBLIC_DONATION_PERK_MESSAGE=Donate $5 or more for 1 year of ad-free drills

# --- Donor perks (ad-free) --------------------------------------------------
# Comma-separated TEST supporter codes ("CODE" or "CODE:USD"). The stub in
# src/lib/donor.ts accepts these; replace it with a server-side check
# before launch. See docs/monetization.md.
# NEXT_PUBLIC_DONOR_CODES=FRIEND:10,SMALL:2
